# How to get every key: see "Getting the API keys" in README.md

# League of Legends (Riot API)
LEAGUE_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
RIOT_ID=YourName#TAG

# Steam
STEAM_API_KEY=your_steam_api_key
STEAM_ID=your_64bit_steam_id

# Spotify OAuth
SPOTIFY_API_CLIENT_ID=your_spotify_client_id
SPOTIFY_API_CLIENT_SECRET=your_spotify_client_secret
# Filled after visiting /api/spotify/auth once
SPOTIFY_REFRESH_TOKEN=
# Optional secret for the Spotify routes (player, controls, lyrics); see "Access token" in README.md
# KINDLE_API_TOKEN=

# Lyrics
LRCLIB_API_URL=https://lrclib.net/api/

# GitHub (Work tab): classic personal access token with the "repo" scope
GITHUB_TOKEN=
# Repos whose latest GitHub Actions run is shown under "Últimos deploys"
GITHUB_DEPLOY_REPOS=KsmKayk/kindle-dashboard,KsmKayk/portfolio

# Shared secret of claude-reporter/ and server-agent/ (POST /api/*/report); unset = reports off
REPORT_TOKEN=

# Sites checked at the bottom of the Servers tab: label=url,label=url
# HEALTHCHECK_URLS=site=https://example.com,api=https://api.example.com/health

# Timezone for "this week" / "this month" on the Work tab
TZ=America/Sao_Paulo

# Update rates in seconds
LEAGUE_UPDATE_RATE=600
STEAM_UPDATE_RATE=60
GITHUB_UPDATE_RATE=600

# Docker only: host port published by compose.yaml (default 3000)
# HOST_PORT=3000
# Docker only: 0.0.0.0 to reach it from the LAN (default 127.0.0.1)
# HOST_BIND=0.0.0.0
