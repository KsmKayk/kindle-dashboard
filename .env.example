# How to get every key: see "Getting the API keys" in README.md

# League of Legends (Riot API)
LEAGUE_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
RIOT_ID=YourName#TAG

# Steam
STEAM_API_KEY=your_steam_api_key
STEAM_ID=your_64bit_steam_id

# Spotify OAuth
SPOTIFY_API_CLIENT_ID=your_spotify_client_id
SPOTIFY_API_CLIENT_SECRET=your_spotify_client_secret
# Filled after visiting /api/spotify/auth once
SPOTIFY_REFRESH_TOKEN=

# Lyrics
LRCLIB_API_URL=https://lrclib.net/api/

# Update rates in seconds
LEAGUE_UPDATE_RATE=600
STEAM_UPDATE_RATE=60
SPOTIFY_UPDATE_RATE=5

# Docker only: host port published by compose.yaml (default 3000)
# HOST_PORT=3000
# Docker only: 0.0.0.0 to reach it from the LAN (default 127.0.0.1)
# HOST_BIND=0.0.0.0
